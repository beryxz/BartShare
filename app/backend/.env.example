# === APP config ===
DEBUG=false # controls logging level, error detail in responses, and hidden-route visibility in OpenAPI
NODE_ENV=production
LOGGING=true # log outputs
TZ=Europe/Rome
DB_CONNECTION_STRING="postgres://xxx:xxx@xxx:000/xxx" # postgres connection string

# === API config ===
API_HOST="127.0.0.1" # host for the API listener
API_PORT="8081" # port for the API listener
EVALUATOR_URL=http://127.0.0.1:8080 # the separate bart-wrapper service (evaluator/bart-wrapper), not this backend
EVALUATOR_TIMEOUT_MS=10000
