# Base URL of the BartShare backend, as reached from the browser.
#
# Leave it empty for same-origin relative URLs (e.g. compose stack)
#
# For a local `npm run dev` against that stack, point it at the proxy:
#   NEXT_PUBLIC_API_HOST=http://localhost:8000
# or, with docker-compose.dev.yml layered on, straight at the backend:
#   NEXT_PUBLIC_API_HOST=http://localhost:8081
#
# `NEXT_PUBLIC_*` is inlined into the client bundle by `next build`, so a change
# only takes effect on the next build; for Docker that means
# `--build-arg NEXT_PUBLIC_API_HOST=...`, not `docker run -e`.
NEXT_PUBLIC_API_HOST=http://localhost:8000
