    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "radix-ui": "^1.6.7",
    "cmdk": "^1.1.1",
    "sonner": "^2.0.8",
    "next-themes": "^0.4.6",
