<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<profiles version="23">
  <profile kind="CodeFormatterProfile" name="bart" version="23">
    <!-- Indentation: 4 spaces, continuation +4. Eclipse defaults continuation to 2 units,
         which would shift every wrapped line in both modules. -->
    <setting id="org.eclipse.jdt.core.formatter.tabulation.char" value="space"/>
    <setting id="org.eclipse.jdt.core.formatter.tabulation.size" value="4"/>
    <setting id="org.eclipse.jdt.core.formatter.indentation.size" value="4"/>
    <setting id="org.eclipse.jdt.core.formatter.continuation_indentation" value="1"/>
    <setting id="org.eclipse.jdt.core.formatter.continuation_indentation_for_array_initializer" value="1"/>

    <!-- Must equal max_line_length in .editorconfig. -->
    <setting id="org.eclipse.jdt.core.formatter.lineSplit" value="100"/>

    <!-- Break over-long lines, never rejoin a deliberate break. join_wrapped_lines only
         preserves a break the alignment considers legal, so assignment must be allowed to
         wrap at all; left at the Eclipse default it un-wraps hand-broken assignments. -->
    <setting id="org.eclipse.jdt.core.formatter.join_wrapped_lines" value="false"/>
    <setting id="org.eclipse.jdt.core.formatter.alignment_for_assignment" value="16"/>
    <setting id="org.eclipse.jdt.core.formatter.alignment_for_arguments_in_annotation" value="16"/>
    <setting id="org.eclipse.jdt.core.formatter.alignment_for_enum_constants" value="16"/>

    <!-- Leave one-line declarations as written: the record value classes state trivial
         accessor overrides on a single line each, which exploding would bury. -->
    <setting id="org.eclipse.jdt.core.formatter.keep_method_body_on_one_line" value="one_line_preserve"/>
    <setting id="org.eclipse.jdt.core.formatter.keep_type_declaration_on_one_line" value="one_line_preserve"/>
    <setting id="org.eclipse.jdt.core.formatter.keep_record_declaration_on_one_line" value="one_line_preserve"/>
    <setting id="org.eclipse.jdt.core.formatter.keep_anonymous_type_declaration_on_one_line" value="one_line_preserve"/>
    <setting id="org.eclipse.jdt.core.formatter.keep_enum_declaration_on_one_line" value="one_line_preserve"/>
    <setting id="org.eclipse.jdt.core.formatter.keep_enum_constant_declaration_on_one_line" value="one_line_preserve"/>
    <setting id="org.eclipse.jdt.core.formatter.keep_annotation_declaration_on_one_line" value="one_line_preserve"/>
    <setting id="org.eclipse.jdt.core.formatter.keep_lambda_body_block_on_one_line" value="one_line_preserve"/>

    <!-- An empty body stays {} rather than being split over two lines. -->
    <setting id="org.eclipse.jdt.core.formatter.insert_new_line_in_empty_type_declaration" value="do not insert"/>
    <setting id="org.eclipse.jdt.core.formatter.insert_new_line_in_empty_method_body" value="do not insert"/>
    <setting id="org.eclipse.jdt.core.formatter.insert_new_line_in_empty_block" value="do not insert"/>
    <setting id="org.eclipse.jdt.core.formatter.insert_new_line_in_empty_enum_declaration" value="do not insert"/>
    <setting id="org.eclipse.jdt.core.formatter.insert_new_line_in_empty_enum_constant" value="do not insert"/>
    <setting id="org.eclipse.jdt.core.formatter.insert_new_line_in_empty_annotation_declaration" value="do not insert"/>
    <setting id="org.eclipse.jdt.core.formatter.insert_new_line_in_empty_anonymous_type_declaration" value="do not insert"/>

    <!-- Prose is hand-authored: Javadoc and block comments are left alone so wrapping and
         {@code} spans survive. Only // comments are wrapped, and join_lines_in_comments
         stops consecutive one-liners being re-flowed into one paragraph. -->
    <setting id="org.eclipse.jdt.core.formatter.comment.format_javadoc_comments" value="false"/>
    <setting id="org.eclipse.jdt.core.formatter.comment.format_block_comments" value="false"/>
    <setting id="org.eclipse.jdt.core.formatter.comment.format_header" value="false"/>
    <setting id="org.eclipse.jdt.core.formatter.comment.format_line_comments" value="true"/>
    <setting id="org.eclipse.jdt.core.formatter.comment.line_length" value="100"/>
    <setting id="org.eclipse.jdt.core.formatter.join_lines_in_comments" value="false"/>

    <!-- An over-long call chain goes one selector per line; a chain that fits stays put. -->
    <setting id="org.eclipse.jdt.core.formatter.alignment_for_selector_in_method_invocation" value="80"/>

    <!-- Test text blocks hold expected trace output whose leading whitespace is asserted. -->
    <setting id="org.eclipse.jdt.core.formatter.text_block_indentation" value="0"/>

    <!-- Set so the profile is also correct if imported directly into an IDE; Spotless's
         endWithNewline covers the build path. -->
    <setting id="org.eclipse.jdt.core.formatter.insert_new_line_at_end_of_file_if_missing" value="insert"/>
  </profile>
</profiles>
